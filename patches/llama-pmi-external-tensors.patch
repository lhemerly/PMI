diff --git a/src/llama-load-observer.h b/src/llama-load-observer.h
new file mode 100644
index 0000000..cd330cb
--- /dev/null
+++ b/src/llama-load-observer.h
@@ -0,0 +1,36 @@
+#pragma once
+#include "llama.h"
+#include <chrono>
+#include <stdexcept>
+
+inline thread_local const llama_load_observer * llama_current_load_observer = nullptr;
+inline thread_local int32_t llama_load_shard = -1;
+inline thread_local const char * llama_load_tensor = nullptr;
+inline uint64_t llama_load_clock_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline void llama_observe_load(llama_load_event_kind kind, uint64_t offset = 0,
+        uint64_t requested = 0, uint64_t completed = 0, uint64_t duration = 0,
+        void * owned = nullptr, uint64_t owned_bytes = 0) {
+    if (!llama_current_load_observer) return;
+    const llama_load_event event{kind, llama_load_clock_ns(), duration,
+        llama_load_shard, llama_load_tensor, offset, requested, completed, owned, owned_bytes};
+    if (!llama_current_load_observer->callback(&event, llama_current_load_observer->user_data)) {
+        throw std::runtime_error("dense load observer rejected event");
+    }
+}
+struct llama_load_observer_scope {
+    explicit llama_load_observer_scope(const llama_load_observer * observer) {
+        if (llama_current_load_observer || !observer || !observer->callback)
+            throw std::runtime_error("invalid or reentrant dense load observer");
+        llama_current_load_observer = observer;
+    }
+    ~llama_load_observer_scope() { llama_current_load_observer = nullptr; }
+};
+struct llama_load_tensor_scope {
+    llama_load_tensor_scope(int32_t shard, const char * name) {
+        llama_load_shard = shard; llama_load_tensor = name;
+    }
+    ~llama_load_tensor_scope() { llama_load_shard = -1; llama_load_tensor = nullptr; }
+};
